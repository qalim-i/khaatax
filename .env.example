EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed to run the payroll RLS test (`npm run test:rls`).
# Put the REAL values in `.env`, which is gitignored — never here. This file is
# committed to the repo. Point them at the DEVELOPMENT project: the test signs in
# and attempts writes.
KHAATAX_TEST_OWNER_EMAIL=owner@example.com
KHAATAX_TEST_OWNER_PASSWORD=
KHAATAX_TEST_MANAGER_EMAIL=manager@example.com
KHAATAX_TEST_MANAGER_PASSWORD=
