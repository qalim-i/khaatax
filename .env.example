EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- RLS test suite (`npm run test:rls`) -------------------------------------
#
# Put the REAL values in `.env`, which is gitignored — never here. This file is
# committed.
#
# These tests WRITE: they insert and delete probe rows in `employees` (payroll),
# `expenses` and `parties`. So they get their own project URL rather than reusing
# EXPO_PUBLIC_SUPABASE_URL. If the two match, the suite refuses to run unless you
# opt in below — otherwise one `npm run test:rls` against a production-pointed
# `.env` writes probe rows into live payroll data.
KHAATAX_TEST_SUPABASE_URL=https://your-dev-project.supabase.co

# Optional. Falls back to EXPO_PUBLIC_SUPABASE_ANON_KEY when unset — the anon key
# is public by design and carries no privilege of its own; the project URL is the
# part that matters.
KHAATAX_TEST_SUPABASE_ANON_KEY=

# Set to `true` ONLY if you genuinely have a single development project and
# accept that the tests write to it. Never set this against production.
KHAATAX_TEST_ALLOW_SHARED_PROJECT=

# Use long, randomly generated passwords. These are real logins, and the owner
# account has unrestricted payroll access.
KHAATAX_TEST_OWNER_EMAIL=owner@example.com
KHAATAX_TEST_OWNER_PASSWORD=
KHAATAX_TEST_MANAGER_EMAIL=manager@example.com
KHAATAX_TEST_MANAGER_PASSWORD=
